{
  "name": "codenoms",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://codenoms.org",
  "type": "module",
  "main": "electron/main.js",
  "description": "Learn programming locally with short, gamified lessons powered by your Claude Code or Codex subscription.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch-path=server server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "serve": "node server/index.js",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dockerode": "^4.0.12",
    "dompurify": "^3.2.0",
    "express": "^4.21.0",
    "highlight.js": "^11.10.0",
    "marked": "^15.0.0",
    "monaco-editor": "^0.52.0",
    "pinia": "^3.0.0",
    "tar-stream": "^3.2.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "org.codenoms.desktop",
    "productName": "Codenoms",
    "icon": "public/logo.svg",
    "directories": { "output": "release" },
    "npmRebuild": false,
    "files": [
      "electron/**",
      "server/**",
      "src/lib/languages.js",
      "src/lib/translation.js",
      "src/locales/**",
      "src/lib/voice-design.js",
      "dist/**",
      "LICENSE",
      "NOTICE",
      "!node_modules/monaco-editor/**",
      "!**/*.node"
    ],
    "asarUnpack": ["server/whisper.py", "server/whisper-requirements.txt", "server/zonos/**"],
    "win": { "target": "nsis" }
  },
  "engines": {
    "node": ">=20.3"
  }
}
