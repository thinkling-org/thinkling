    "express": "^4.21.0",
    "highlight.js": "^11.10.0",
    "marked": "^15.0.0",
    "monaco-editor": "^0.52.0",
    "pinia": "^3.0.0",
    "tar-stream": "^3.2.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
