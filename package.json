{
  "name": "thinkling",
  "version": "0.1.4",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Thinkling",
    "email": "support@thinkling.org"
  },
  "homepage": "https://github.com/thinkling-org/thinkling",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkling-org/thinkling.git"
  },
  "type": "module",
  "main": "dist-node/electron/main.js",
  "description": "Learn programming locally with short, gamified lessons powered by your Claude Code or Codex subscription.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.ts\" \"vite\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:all": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --project=chromium --ui",
    "test:e2e:report": "playwright show-report",
    "test:desktop-updates": "electron tests/smoke/desktop-updates.cjs",
    "test:installer-lifecycle": "node tests/smoke/installer-lifecycle.cjs",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build",
    "start": "npm run build && npm run serve",
    "serve": "node server/index.ts",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --publish never",
    "desktop:package:win": "npm run build && electron-builder --win --publish never",
    "desktop:package:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:package:linux": "npm run build && electron-builder --linux --publish never",
    "desktop:release:win": "npm run build && electron-builder --win --x64 --publish always",
    "desktop:release:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish always",
    "desktop:release:linux": "npm run build && electron-builder --linux --x64 --publish always",
    "plugin:pack": "node scripts/pack-plugin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dockerode": "^4.0.12",
    "dompurify": "^3.2.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.10.0",
    "marked": "^15.0.0",
    "monaco-editor": "^0.52.0",
    "pinia": "^3.0.0",
    "tar-stream": "^3.2.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/tar-stream": "^3.1.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "concurrently": "^9.1.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "typescript": "5.9",
    "vite": "^6.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "org.codenoms.desktop",
    "productName": "Thinkling",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "thinkling-org",
      "repo": "thinkling",
      "releaseType": "draft"
    },
    "files": [
      "dist-node/**",
      "server/whisper.py",
      "server/whisper-requirements.txt",
      "dist/**",
      "LICENSE",
      "NOTICE",
      "!node_modules/monaco-editor/**",
      "!**/*.node"
    ],
    "asarUnpack": [
      "server/whisper.py",
      "server/whisper-requirements.txt"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "executableName": "thinkling",
      "synopsis": "Learn programming with short, gamified lessons",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
